# --- Brother Scanner Settings ---
# (Static) IP of your Brother scanner
BRSCAN_IP=192.168.178.50

# SANE registration name and exact Brother model
SCANNER_NAME=Brother_Scanner
SCANNER_MODEL=MFC-7360N
# SHA-256 of brscan-skey-0.3.5-0.amd64.deb
BRSCAN_SKEY_SHA256=cda25534ea8e3018e7d46b970cb08b36084355adedc933aba0c8c7d03e903db9

# The name that will appear on the scanner's display (max 15 chars)
SCAN_PC_NAME=ScanToPaperless

# --- Paperless-ngx Settings ---
# Full URL to your Paperless instance (including port if necessary)
PAPERLESS_URL=http://192.168.178.100:8000

# Your secret API Token (get it from Paperless -> Settings -> API Tokens)
PAPERLESS_TOKEN=your_very_long_secret_api_token_here

# --- Network & Web UI Settings ---
# Port for the AirSane web interface (legacy scan via browser)
AIRSANE_PORT=8095
AIRSANE_DEBUG=false

# --- Scan & reliability settings ---
# Optional direct device avoids probing every installed SANE backend.
# The first registered brscan4 network scanner is normally net1/dev0.
SCAN_DEVICE="brother4:net1;dev0"
SCAN_RESOLUTION=100
SCAN_SOURCE=FB
SCAN_SIZE=A4
SCAN_DUPLEX=false
UPLOAD_RETRIES=3
# Maximum time a second uploader waits while another upload is active
UPLOAD_LOCK_TIMEOUT=330
# Wait for Paperless to finish consuming the accepted document.
PAPERLESS_TASK_TIMEOUT=300
PAPERLESS_TASK_POLL_INTERVAL=5
QUEUE_RETRY_INTERVAL=60
SANE_ONLY_BROTHER4=true
