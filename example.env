# --- Brother Scanner Settings ---
# (Static) IP of your Brother scanner
BRSCAN_IP=192.168.178.50

# The name that will appear on the scanner's display (max 15 chars)
SCAN_PC_NAME=ScanToPaperless

# --- Paperless-ngx Settings ---
# Full URL to your Paperless instance (including port if necessary)
PAPERLESS_URL=http://192.168.178.100:8000

# Your secret API Token (get it from Paperless -> Settings -> API Tokens)
PAPERLESS_TOKEN=your_very_long_secret_api_token_here

# --- Network & Web UI Settings ---
# Port for the AirSane web interface (legacy scan via browser)
AIRSANE_PORT=8095